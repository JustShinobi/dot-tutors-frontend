# ---------------------------------------------------------------------------
# Exemplo de configuracao. Copie para .env.local e ajuste.
#
# Somente variaveis NEXT_PUBLIC_* sao expostas ao browser. Nenhum segredo do
# backend (chave do Gemini, JWT_SECRET) deve aparecer aqui: o widget conversa
# com a API usando uma embed key publica e um token de sessao de curta duracao.
# ---------------------------------------------------------------------------

# URL da API, usada pelo browser (admin e widget).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# URL publica deste app, usada para montar o snippet de <iframe>.
NEXT_PUBLIC_APP_BASE_URL=http://localhost:3000

# Embed key usada pela pagina /demo. E publica por natureza: aparece no HTML
# do site integrador. O que protege o tutor e a allowlist de origens da chave.
NEXT_PUBLIC_DEMO_EMBED_KEY=

# URL da API acessada pelo servidor Next.js (middleware de CSP). Em Docker,
# aponta para o hostname do servico; localmente e igual a NEXT_PUBLIC_API_BASE_URL.
API_INTERNAL_BASE_URL=http://localhost:8000
